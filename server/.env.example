# Required when NODE_ENV=production. Generate a long random token and store it only on the worker and the Next.js server.
RENDER_API_TOKEN=

# The Next.js server should send the same token through REEDITX_RENDER_API_TOKEN.
PORT=8787
HOST=0.0.0.0
MAX_UPLOAD_MB=1024
MAX_MEDIA_SECONDS=14400
MAX_CONCURRENT_RENDERS=1
MAX_QUEUED_RENDERS=4
RENDER_REQUESTS_PER_15_MIN=6
JOB_TTL_HOURS=3
REEDITX_JOB_DIR=/data/reeditx-jobs
CORS_ORIGINS=https://your-app-domain.example
TRUST_PROXY=1

# Debian Docker image provides these executables and font.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_PRESET=veryfast
FFMPEG_CRF=21
FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
