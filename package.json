{
  "name": "reeditx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.8.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.gemaaofficials.reeditx",
    "productName": "ReEditX",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app-server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app-server/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-runtime/node.exe",
        "to": "node.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ReEditX.setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReEditX",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
