{
  "name": "reeditx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron .",
    "desktop:build": "electron-builder --win nsis",
    "desktop": "electron ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2",
    "@fastify/busboy": "^3.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.8.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.17.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.gemaa.reeditx",
    "productName": "ReEditX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ReEditX.setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReEditX"
    }
  }
}
