# Optional: public URL of the dedicated ReEditX FFmpeg worker. Example: https://reeditx-render.example.com
REEDITX_RENDER_SERVER_URL=

# Secret shared only by the Next.js server and the render worker. Generate a long random value.
REEDITX_RENDER_API_TOKEN=

# Optional Electron release configuration; public URL only, never a secret.
REEDITX_APP_URL=
